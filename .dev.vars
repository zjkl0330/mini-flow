# 本地开发变量示例（wrangler dev 会自动读取本目录下的 .dev.vars）
#
# 用法：把本文件复制为 .dev.vars —— 该文件已被 .gitignore 忽略，切勿提交。
#   cp .dev.vars.example .dev.vars
#
# 为什么必须这样做：自本轮安全收口起，「开发回退口令」只在
# ENVIRONMENT 显式为 development/dev/local 时生效；未声明即按生产处理，
# /rest/login 会返回 503 而不是用默认口令放行。

ENVIRONMENT="development"

# 下面两项在生产环境必须用 `wrangler secret put` 设置（不要写进 wrangler.jsonc）。
# ADMIN_PASSWORD 至少 8 位；SESSION_SECRET 至少 16 位。
ADMIN_PASSWORD="mini-flow-local-dev-password"
SESSION_SECRET="mini-flow-local-dev-signing-secret"
